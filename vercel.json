{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/municipios.js": {
      "includeFiles": "api/data/**"
    },
    "api/editais-proximos.js": {
      "maxDuration": 60,
      "includeFiles": "api/data/**"
    },
    "api/editais-chat.js": {
      "maxDuration": 60,
      "includeFiles": "api/data/**"
    },
    "api/chat-editais.js": {
      "maxDuration": 60,
      "includeFiles": "api/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|[^/]+\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
