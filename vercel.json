{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "api/data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|[^/]+\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
