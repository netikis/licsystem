# Copie para .env e preencha. Nunca commite o arquivo .env.

# Firebase Web — Vite (obrigatório no frontend / build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase — API serverless (opcional; aceita também VITE_FIREBASE_*)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Gemini — apenas nas Functions da Vercel (api/analyze-pdf.js) — NÃO use VITE_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# PNCP / Editais próximos — API pública, sem chave.
# Rotas: /api/editais-proximos e /api/municipios (Vercel serverless).
# Autocomplete de município também usa public/municipios.json (fallback offline).
# Busca de editais no raio exige a API: npm run dev (Vite+API) ou deploy Vercel.

# Alertas automáticos PNCP — /api/monitor-pncp
# Opcional: se definido, a rota exige Authorization: Bearer <segredo>
# MONITOR_CRON_SECRET=

# Mercado Livre — SOMENTE backend (api/search-ml.js, api/ml-proxy.js)
# NÃO use prefixo VITE_ (não pode ir para o browser)
ML_APP_ID=
ML_CLIENT_SECRET=

# Busca ML em produção (Vercel) — cada CLIENTE coloca as CHAVES DELE no projeto dele.
# A API oficial /sites/MLB/search retorna 403 no IP da Vercel.
# Custo zero para o VENDEDOR: você não paga a busca dos clientes.
#
# Opção A (grátis para testar): https://serper.dev → 2.500 buscas no cadastro
SERPER_API_KEY=
#
# Opção B (Google, ~100/dia grátis se a conta permitir):
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_CX=
