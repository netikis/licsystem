# Copie para .env e preencha. Nunca commite o arquivo .env.

# Firebase Web — Vite (obrigatório no frontend / build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase — API serverless (opcional; aceita também VITE_FIREBASE_*)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Gemini — apenas nas Functions da Vercel (api/analyze-pdf.js) — NÃO use VITE_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
